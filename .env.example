# ---------------------------------------------------------------------------
# Plex MCP server configuration. Copy to .env and fill in.
# (scripts\windows\install.ps1 does this for you, including the tokens.)
# ---------------------------------------------------------------------------

# --- Plex connection --------------------------------------------------------
# On the Plex machine itself, localhost is simplest.
PLEX_URL=http://127.0.0.1:32400
# Admin X-Plex-Token. See README "Finding your Plex token".
PLEX_TOKEN=
# PLEX_TIMEOUT=30
# Set to false only if PLEX_URL is https with a self-signed certificate.
# PLEX_VERIFY_SSL=true

# --- HTTP transport ---------------------------------------------------------
# 0.0.0.0 = reachable from your LAN. 127.0.0.1 = this machine only.
PLEX_MCP_HOST=0.0.0.0
PLEX_MCP_PORT=8765
# PLEX_MCP_PATH=/mcp
# Clients must send "Authorization: Bearer <this>". Required unless PLEX_MCP_HOST is 127.0.0.1.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLEX_MCP_AUTH_TOKEN=
# Host names/IPs clients use to reach this server (comma-separated).
# Leave empty to auto-detect this machine's name and IPs. Set to * to disable the check.
# PLEX_MCP_ALLOWED_HOSTS=plex-server,192.168.1.50

# --- Safety -----------------------------------------------------------------
# true = only read/search tools are available.
PLEX_MCP_READ_ONLY=false
# false = hide the delete_collection and delete_playlist tools.
PLEX_MCP_ALLOW_DELETE=true
# Restrict to these libraries (titles or IDs, comma-separated). Empty = all.
# PLEX_MCP_ALLOWED_LIBRARIES=Movies,TV Shows
# Hard cap on results returned by list/search tools.
# PLEX_MCP_MAX_RESULTS=200

# --- Logging ----------------------------------------------------------------
PLEX_MCP_LOG_LEVEL=INFO
# PLEX_MCP_LOG_FILE=logs\plex-mcp.log
